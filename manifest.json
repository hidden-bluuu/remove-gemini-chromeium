{
  "manifest_version": 3,
  "name": "No Google AI",
  "version": "2.0",
  "description": "Removes Google AI Overviews and AI Mode from search, with settings to fine-tune what you see.",
  "permissions": [
    "declarativeNetRequest",
    "storage"
  ],
  "host_permissions": [
    "https://www.google.com/*",
    "https://www.google.co.uk/*",
    "https://www.google.de/*",
    "https://www.google.fr/*",
    "https://www.google.it/*",
    "https://www.google.es/*",
    "https://www.google.nl/*",
    "https://www.google.pl/*",
    "https://www.google.at/*",
    "https://www.google.ch/*",
    "https://www.google.be/*",
    "https://www.google.se/*",
    "https://www.google.no/*",
    "https://www.google.dk/*",
    "https://www.google.fi/*",
    "https://www.google.ie/*",
    "https://www.google.pt/*",
    "https://www.google.cz/*",
    "https://www.google.hr/*",
    "https://www.google.si/*",
    "https://www.google.sk/*",
    "https://www.google.hu/*",
    "https://www.google.ro/*",
    "https://www.google.gr/*",
    "https://www.google.ca/*",
    "https://www.google.com.au/*",
    "https://www.google.co.nz/*",
    "https://www.google.co.in/*",
    "https://www.google.co.jp/*",
    "https://www.google.com.br/*",
    "https://www.google.com.mx/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/*",
        "https://www.google.co.uk/*",
        "https://www.google.de/*",
        "https://www.google.fr/*",
        "https://www.google.it/*",
        "https://www.google.es/*",
        "https://www.google.nl/*",
        "https://www.google.pl/*",
        "https://www.google.at/*",
        "https://www.google.ch/*",
        "https://www.google.be/*",
        "https://www.google.se/*",
        "https://www.google.no/*",
        "https://www.google.dk/*",
        "https://www.google.fi/*",
        "https://www.google.ie/*",
        "https://www.google.pt/*",
        "https://www.google.cz/*",
        "https://www.google.hr/*",
        "https://www.google.si/*",
        "https://www.google.sk/*",
        "https://www.google.hu/*",
        "https://www.google.ro/*",
        "https://www.google.gr/*",
        "https://www.google.ca/*",
        "https://www.google.com.au/*",
        "https://www.google.co.nz/*",
        "https://www.google.co.in/*",
        "https://www.google.co.jp/*",
        "https://www.google.com.br/*",
        "https://www.google.com.mx/*"
      ],
      "js": [
        "defaults.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "No Google AI",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "toggle-enabled": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Turn No Google AI on or off"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
